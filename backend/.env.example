# Node
# Process time zone. `UTC` in every environment: when absent, Node inherits the
# host zone and the same query answers different dates depending on the machine.
# Converting to the reader's zone is the presentation layer's job.
TZ=UTC
PORT=3333
# In a container use `0.0.0.0`: `localhost` only accepts connections from inside
# the container itself, and the host proxy never gets through.
HOST=localhost
NODE_ENV=development

# App
LOG_LEVEL=info
APP_KEY=
# This API's public address (the OpenAPI `servers` entry).
# In production: APP_URL=https://api-curupira.maiyu.com.br
APP_URL=http://${HOST}:${PORT}
# The frontend origin, no trailing slash. It is the CORS allowlist and the origin
# barrier (CSRF) at once: every write whose `Origin` is not this one gets 403, in
# development too. `*` is not an option: the API uses cookies.
# In production: SITE_URL=https://curupira.maiyu.com.br
SITE_URL=http://localhost:3001

# Trusted reverse proxy, so the per-IP limit (anonymous reports included) sees the
# client and not the proxy. Required. A single value (IP, subnet or
# `loopback`/`linklocal`/`uniquelocal`); never `true`.
# In production behind the Coolify Traefik: TRUSTED_PROXIES=loopback,uniquelocal
TRUSTED_PROXIES=loopback

# The `Domain` of the session cookies. Empty in development, which is right:
# cookies ignore the port, so `localhost:3333` and `localhost:3001` already share
# the same domain.
#
# In production it is **required**, and the schema does not enforce it: without it
# the cookie is born host-only on the API host and the frontend SSR never receives
# it, so every F5 on a private route goes back to the sign-in screen.
# In production: COOKIE_DOMAIN=.maiyu.com.br
# COOKIE_DOMAIN=.maiyu.com.br

# Database
# 5436 and not 5432: other projects on the same machine already use the
# previous ports.
DATABASE_URL=postgres://curupira:curupira@localhost:5436/curupira
# TLS on the connection. It depends on where the database is, not on the
# environment: a database on the application's private network usually does not
# speak TLS (leave it absent or `false`); a managed database usually requires it
# (`true`).
# DATABASE_SSL=false

# Storage
# Upload is presigned: the binary goes from the browser straight to the bucket and
# never crosses this application. The target is an S3-compatible bucket in every
# environment - MinIO in dev and in tests, and in production whatever
# STORAGE_ENDPOINT points to.
#
# Per-file ceiling of the panel file library, in bytes. Required. Below, 1 GiB.
UPLOAD_MAX_SIZE=1073741824
# Per-photo ceiling of the anonymous report upload, in bytes. Required, and much
# smaller than the one above: the route has no login. Below, 10 MiB.
REPORT_PHOTO_MAX_SIZE=10485760

# Local MinIO (docker compose up -d). Console at http://localhost:9007.
STORAGE_KEY=curupira
STORAGE_SECRET=curupira-secret
STORAGE_BUCKET=curupira
STORAGE_ENDPOINT=http://localhost:9006
# MinIO only serves `endpoint/bucket/key`. In production (R2, S3, Spaces), remove.
STORAGE_FORCE_PATH_STYLE=true

# In production:
# STORAGE_ENDPOINT=https://<account>.r2.cloudflarestorage.com  (or s3.<region>.amazonaws.com, etc.)
#
# The bucket is **private**: nothing in it is served by a public URL, and every
# read goes through a short-lived signed URL. The production bucket needs CORS
# open to the frontend origin (https://curupira.maiyu.com.br), with PUT in the
# methods and `ETag` in ExposeHeaders. The policy is not applied by deploy: set it
# in the provider panel.

# Seeding
# The e-mail and password of the owner (ADMINISTRATOR) that `node ace db:seed`
# creates. Without the password the seeder stops, on purpose: a password in the
# code is a credential for every already seeded environment, production included.
# The application starts without these: only the seeder, run by hand, needs them.
SEED_OWNER_EMAIL=owner@mail.com
SEED_OWNER_PASSWORD=
