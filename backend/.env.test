# Database
# A database SEPARATE from the development one: the suite runs `truncate()`
# between tests. Create it once with:
#   docker compose exec database createdb -U curupira curupira_test
DATABASE_URL=postgres://curupira:curupira@localhost:5436/curupira_test

# Storage
# Presigned upload: the suite talks to the docker-compose MinIO, the same code path
# as production. Bucket SEPARATE from the development one (created by `minio-setup`).
#
# The ceiling is 16 GiB here, deliberately above the dev one: the suite must declare
# sizes the development ceiling would refuse. Nothing is transferred.
UPLOAD_MAX_SIZE=17179869184
REPORT_PHOTO_MAX_SIZE=10485760

STORAGE_KEY=curupira
STORAGE_SECRET=curupira-secret
STORAGE_BUCKET=curupira-test
STORAGE_ENDPOINT=http://localhost:9006
STORAGE_FORCE_PATH_STYLE=true

# The frontend origin the test client sends (`tests/bootstrap.ts`). `NODE_ENV=test`
# applies the allowlist, which is the path `cors.middleware.e2e.spec.ts` exercises.
SITE_URL=http://localhost:5173
TRUSTED_PROXIES=loopback

# Seeding
# The suite runs `db().seed()` on every test, and the seeder refuses an absent password.
SEED_OWNER_EMAIL=owner@mail.com
SEED_OWNER_PASSWORD=Owner1234!
