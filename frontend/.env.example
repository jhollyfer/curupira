# API
# Base of the AdonisJS API. In dev it is the port `backend/pnpm dev` starts.
#
# The `VITE_` prefix is what makes Vite embed the value in the browser bundle -
# that is, publish it. No secret goes in this file: API keys, passwords and
# third-party tokens stay in the backend `.env`, which never reaches the client.
VITE_API_URL=http://localhost:3333

# Site URL
# The public site address (canonical, hreflang and sitemap). In dev it is the
# port `pnpm dev` starts. No trailing slash.
VITE_SITE_URL=http://localhost:3000

# Data source
# `mock` serves src/data/* with no backend; `api` talks to VITE_API_URL.
# The single switch lives in src/integrations/tanstack-query/source.ts.
VITE_DATA_SOURCE=mock

# Storage origin
# The browser PUTs each report photo straight to the bucket through a presigned URL, and
# the production CSP (`vite.config.ts`) only lets `connect-src`/`img-src` reach origins
# listed here. Without it every photo upload is blocked in production. It is the origin
# of `STORAGE_ENDPOINT` in the backend (no path, no trailing slash); with the bucket in
# path style it is the endpoint itself, with virtual-host style it is
# `https://<bucket>.<endpoint host>`.
# In dev: the local MinIO, http://localhost:9006
VITE_STORAGE_URL=http://localhost:9006
