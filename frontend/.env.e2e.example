# Environment of the E2E run (`e2e/support/env.ts`). No default: when one is missing, the run
# stops and says which. Copy to `.env.e2e` (ignored by Git); in CI the same keys come from
# the workflow environment.
#
# The origin of the web app the suite starts (`vite dev` on that port) and the API it
# talks to. The API's `CORS_ORIGINS` must list the first one.
E2E_BASE_URL=http://localhost:3010
E2E_API_URL=http://localhost:3333

# The ADMINISTRATOR the backend seeder creates: the same values as `SEED_OWNER_EMAIL` and
# `SEED_OWNER_PASSWORD` in `backend/.env`. The OPERATOR is not here: the specs create one per
# run, with the owner's session.
E2E_OWNER_EMAIL=
E2E_OWNER_PASSWORD=

# Optional: a Chromium binary to use instead of Playwright's own.
# E2E_CHROMIUM_PATH=
