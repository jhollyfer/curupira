# Credentials of the panel's e2e specs (`e2e/support/credentials.ts`).
# The owner is the ADMINISTRATOR the backend seeder creates: use the same values as
# SEED_OWNER_EMAIL / SEED_OWNER_PASSWORD in backend/.env. The specs run
# against the real API (VITE_DATA_SOURCE=api, set by the Playwright config).
E2E_OWNER_EMAIL=
E2E_OWNER_PASSWORD=

# The OPERATOR account the specs create (with the owner's session) and use to check what
# the role cannot open.
E2E_OPERATOR_EMAIL=
E2E_OPERATOR_PASSWORD=

# Optional: port of the dev server the suite starts, and a Chromium binary to use.
E2E_PORT=3010

# The API the specs and the dev server talk to. Its SITE_URL must be http://localhost:<E2E_PORT>.
E2E_API_URL=http://localhost:3333
# E2E_CHROMIUM_PATH=
