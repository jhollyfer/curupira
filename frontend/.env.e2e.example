# Credentials of the panel's e2e specs (`e2e/support/credentials.ts`).
# The owner is the ADMINISTRATOR the backend seeder creates: use the same values as
# SEED_OWNER_EMAIL / SEED_OWNER_PASSWORD in backend/.env. Leave both unset to run against
# the example data (VITE_DATA_SOURCE=mock, development only), which has its own accounts.
E2E_OWNER_EMAIL=
E2E_OWNER_PASSWORD=

# Optional: an OPERATOR account, for the specs that check what the role cannot open.
E2E_OPERATOR_EMAIL=
E2E_OPERATOR_PASSWORD=

# Optional: port of the dev server the suite starts, and a Chromium binary to use.
E2E_PORT=3010
# E2E_CHROMIUM_PATH=
